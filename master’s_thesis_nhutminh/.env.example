# ─────────────────────────────────────────────────────────────────────────────
# PlateReader LR — biến môi trường cho docker-compose.yml
#   cp .env.example .env    rồi sửa giá trị. KHÔNG commit file .env.
# Biến PLATEREADER_* được backend đọc (backend/app/core/config.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=platereader
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platereader
# Port publish ra localhost (chỉ 127.0.0.1) để dùng psql/DBeaver khi dev
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=256MB
TZ=Asia/Ho_Chi_Minh

# ── Backup (service `backup`, profile `backup` — TẮT khi dev) ───────────────
# Bật từ Tuần 10 (có review thật):  docker compose --profile backup up -d
# Chụp tay 1 bản:                    docker compose run --rm -e BACKUP_ONCE=1 backup
# Khi bật: pg_dump mỗi 6 giờ, giữ 7 ngày (= 28 bản). Xem tuan2_bao_cao.md mục 6.
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups

# ── API container ────────────────────────────────────────────────────────────
API_PORT=8000
API_IMAGE_TAG=latest
API_MEMORY_LIMIT=3g
UVICORN_WORKERS=1

# Thư mục chứa checkpoint trên máy host (mount read-only vào /models)
MODEL_CHECKPOINT_DIR=./results/multi-seed/s1_mf_sr_ocr
MODEL_CHECKPOINT_FILE=s1_seed42_best.pth

# ── Backend settings (PLATEREADER_*) ─────────────────────────────────────────
# Kết nối DB và đường dẫn checkpoint được docker-compose tự ghép từ các biến trên.
# Khi chạy uvicorn / pytest trực tiếp trên máy (không Docker), bỏ comment các dòng sau:
# PLATEREADER_DB_HOST=localhost
# PLATEREADER_DB_PASSWORD=change-me
# PLATEREADER_CHECKPOINT_PATH=results/multi-seed/s1_mf_sr_ocr/s1_seed42_best.pth

PLATEREADER_MODEL_NAME=MF-SR-OCR (S1)
# 8 cho S1/J1, 4 cho S4 (sr_scale=1) — không suy ra được từ checkpoint
PLATEREADER_WIDTH_DOWNSAMPLE=8
PLATEREADER_DEVICE=cpu
PLATEREADER_TORCH_THREADS=4
PLATEREADER_DEFAULT_DECODE=constrained
PLATEREADER_BEAM_WIDTH=16
PLATEREADER_PLATE_LAYOUTS=LLLNLNN,LLLNNNN

# Ngưỡng τ: track_conf >= τ -> accepted, ngược lại needs_review.
# 0.90 là giá trị TẠM; τ chính thức chọn ở Tuần 5 (precision >= 95% trên val).
PLATEREADER_CONFIDENCE_THRESHOLD=0.90
PLATEREADER_MAX_SUGGESTIONS=5

# Giới hạn upload
PLATEREADER_MAX_FRAMES=5
PLATEREADER_MAX_IMAGE_MB=5
PLATEREADER_MAX_ZIP_MB=200
PLATEREADER_MAX_BATCH_TRACKS=5000
PLATEREADER_INFERENCE_BATCH_SIZE=4

# Connection pool / timeout (bài toán đọc-ghi đồng thời)
PLATEREADER_DB_POOL_MIN=1
PLATEREADER_DB_POOL_MAX=10
PLATEREADER_DB_POOL_TIMEOUT_S=10
PLATEREADER_DB_STATEMENT_TIMEOUT_MS=15000

# CORS — origin của React (Vite dev server), dạng JSON list
PLATEREADER_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Cloudflare Tunnel (tuỳ chọn, profile `public`) ───────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
